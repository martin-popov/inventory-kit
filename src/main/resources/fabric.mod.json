{
	"schemaVersion": 1,
	"id": "inventorykit",
	"version": "${version}",
	"name": "Inventory Kit",
	"description": "Inventory tools: cycle your inventory rows through the hotbar with Tab, and deposit, take, sort and search items in chests and your inventory.",
	"authors": [
		"martin-popov"
	],
	"contact": {
		"homepage": "https://github.com/martin-popov/inventory-kit",
		"sources": "https://github.com/martin-popov/inventory-kit",
		"issues": "https://github.com/martin-popov/inventory-kit/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.martinpopov.inventorykit.client.InventoryKitClient"
		],
		"modmenu": [
			"com.martinpopov.inventorykit.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "inventorykit.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-rendering-v1": "*",
		"fabric-screen-api-v1": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
